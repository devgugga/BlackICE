# infra secrets
infra/.env
# node / vite
apps/frontend/node_modules/
apps/frontend/dist/
# quarkus / maven
apps/backend/target/

# superpowers sdd scratch (briefs, reports, ledger, review diffs)
.superpowers/

# isolated implementation worktrees
.worktrees/

# editor (apenas .vscode do root; apps/frontend/.vscode é do template Vite)
/.vscode/

# graphify local-only state; portable graphify-out/ artifacts are versioned
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
*.graphify-bak
*.graphify.log

# Graphify assistant hooks embed this machine's executable path. Recreate them
# locally with .graphify/setup.ps1; only portable agent instructions are tracked.
.codex/hooks.json
.claude/settings.json

# Saídas dos instaladores project-scoped do Graphify que NÃO são a fonte da
# verdade deste projeto. As skills revisadas ficam em .agents/skills/graphify/
# (Codex) e .claude/skills/graphify/ (Claude); estas duas são cópias stock que o
# setup regenera a cada execução. Ver docs/architecture/graphify.md.
.codex/skills/
.claude/CLAUDE.md

# python cache
__pycache__/
*.py[cod]

