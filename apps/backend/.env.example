# Env vars do backend para DEV-MODE local (`mise exec -- mvn quarkus:dev`).
# Copie para `apps/backend/.env` (gitignored) e ajuste os valores.
#
# Em container, estes valores vêm de `infra/.env` via `infra/compose.apps.yml`
# e sobrescrevem qualquer coisa daqui — este arquivo é só para o dev-mode.

# Client secret do client OIDC `blackice-quarkus` no Keycloak (realm dcm4chee).
QUARKUS_OIDC_SECRET=change-me-oidc

# Chave dedicada (>= 32 caracteres) para o TokenStateManager criptografar os
# cookies de sessão OIDC. `application.properties` referencia esta var SEM
# default, então o dev-mode NÃO sobe sem ela. Não reutilize o client secret.
QUARKUS_OIDC_ENCRYPTION_SECRET=change-me-session-encryption-32-plus
