# Hostname base servido pelo Traefik (mesma origem)
APP_HOST=blackice.localhost

# Postgres do PRODUTO (Quarkus) — distinto do Postgres do DCM4CHEE
PRODUCT_DB=blackice
PRODUCT_DB_USER=blackice
PRODUCT_DB_PASSWORD=change-me-product

# Segredo do client OIDC do Quarkus (definido na Task 3)
QUARKUS_OIDC_SECRET=change-me-oidc

# --- DCM4CHEE-secure (Task 2): ldap + keycloak + mariadb + arc-db + arc ---

# Hostname usado pelo Keycloak (issuer, KC_HOSTNAME) e pelo Archive
# (ARCHIVE_HOST / UI_AUTH_SERVER_URL) para URLs voltadas ao cliente/browser.
DCM4CHEE_HOST=localhost

# Admin do realm master do Keycloak (usuário fixo: admin)
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Postgres do DCM4CHEE (arc-db) — distinto do Postgres do produto
DCM4CHEE_DB=pacsdb
DCM4CHEE_DB_USER=pacs
DCM4CHEE_DB_PASSWORD=change-me-dcm4chee-db

# MariaDB — banco de dados exigido pelo Keycloak nesta baseline
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_DB_ROOT_PASSWORD=change-me-keycloak-db-root
